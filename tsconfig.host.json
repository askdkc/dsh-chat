{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "declaration": true, "emitDeclarationOnly": true,
    "types": ["node"], "noEmitOnError": true
  },
  "include": ["src/index.ts", "src/host/**/*.ts", "src/shared/**/*.ts"]
}
