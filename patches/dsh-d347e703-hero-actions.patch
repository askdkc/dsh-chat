+++ b/packages/client/ui-conversation/tests/assembly-surfaces.client.spec.tsx
@@ -107,6 +107,39 @@ describe('resident composer', () => {
     await runtime.dispose()
   })
 
+  it('renders ordered root Hero actions beside the working picker before a Session exists', async () => {
+    const runtime = await SlotTestRuntime.create()
+    runtime.ctx.provide('uiWorkspace', { connectWorkspace: vi.fn(async () => SID) } as never)
+    runtime.ctx.provide('settingsScope', { bind: () => stubSettingsScope().scope } as never)
+    const locale = new LocaleRuntime(runtime.ctx)
+    runtime.ctx.provide('locale', locale)
+    runtime.slots.installLocale(locale)
+    await runtime.root.declare(LAYOUT_CHILDREN, AppRoot)
+    await runtime.mount({ inject: [...inject], apply })
+    runtime.slots.register({ name: 'conversation.hero.workspace' }, WorkspaceProbe)
+    const calls = vi.fn()
+    const owner = vi.fn()
+    const remove = runtime.slots.register({ name: 'conversation.hero.actions', id: 'first', order: 10 }, (props) => {
+      owner(props.sessionId, props.workspaceId)
+      return <button data-testid="hero-first" onClick={calls}>First</button>
+    })
+    runtime.slots.register({ name: 'conversation.hero.actions', id: 'second', order: 20 }, () => <button data-testid="hero-second">Second</button>)
+    const view = runtime.renderRoot()
+    expect(owner).toHaveBeenCalledWith(undefined, undefined)
+    const action = view.getByTestId('hero-first')
+    expect(action.closest('[inert], fieldset[disabled]')).toBeNull()
+    fireEvent.click(action)
+    expect(calls).toHaveBeenCalledTimes(1)
+    expect(action.compareDocumentPosition(view.getByTestId('hero-second')) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy()
+    fireEvent.click(view.getByRole('button', { name: '选择工作区' }))
+    expect(view.getByTestId('workspace-probe').textContent).toBe('true:0')
+    expect(view.container.querySelector('[data-composer-input]')?.getAttribute('contenteditable')).not.toBe('true')
+    await act(async () => { remove() })
+    expect(view.queryByTestId('hero-first')).toBeNull()
+    expect(view.getByTestId('hero-second')).toBeTruthy()
+    await runtime.dispose()
+  })
+
